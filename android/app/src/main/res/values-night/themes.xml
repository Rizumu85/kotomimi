<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- In the dark: a dark theme under the page (the system's questions are asked in it), the bars' icons pale. -->
    <style name="Theme.Node" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/wall</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/key</item>
    </style>
</resources>
